@page
@model Apetrei_Andrei_Lab2.Pages.BorrowingPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Borrowing</h4>
    <hr />
    <dl class="row">
        <!-- AFIȘĂM NUMELE MEMBRULUI -->
        <dt class="col-sm-2">Member</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Borrowing.Member.FullName)</dd>

        <!-- AFIȘĂM TITLUL CĂRȚII -->
        <dt class="col-sm-2">Book</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Borrowing.Book.Title)</dd>

        <!-- AFIȘĂM AUTORUL CĂRȚII -->
        <dt class="col-sm-2">Author</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Borrowing.Book.Author.FullName)</dd>

        <!-- AFIȘĂM DATA RETURNĂRII -->
        <dt class="col-sm-2">Return Date</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Borrowing.ReturnDate)</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Borrowing.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>